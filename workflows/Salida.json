    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $input.item.json;\nconst correo = String(c.correo_paciente || '').trim();\nconst fecha = new Date(c.horario_asignado).toLocaleString('es-GT', {\n  timeZone: 'America/Guatemala',\n  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',\n  hour: '2-digit', minute: '2-digit'\n});\n\nreturn {\n  json: {\n    id: c.id,\n    correo_paciente: correo,\n    tiene_correo: correo.length > 0,\n    asunto: 'Confirmación de su cita en MediNova',\n    texto: `Estimado/a ${c.nombre_paciente}:\\n\\nSu cita de ${c.especialidad} ha sido confirmada para el ${fecha} (hora de Guatemala).\\n\\nSi no puede asistir, comuníquese con la clínica para reprogramarla.\\n\\nMediNova`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "d2c78d90-16af-4d86-813d-9c5b83106f66",
      "name": "Armar correo"
    },
