    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $('Buscar doctor').item.json;\nconst lockVencido = item.bloqueado_hasta && new Date(item.bloqueado_hasta) <= new Date();\nconst base = lockVencido ? 0 : item.intentos_fallidos;\nconst intentosActuales = base + 1;\nconst debeBloquear = intentosActuales >= 3;\n\nlet bloqueadoHasta = null;\nif (debeBloquear) {\n  bloqueadoHasta = new Date(Date.now() + 15 * 60 * 1000).toISOString();\n}\n\nreturn {\n  json: {\n    ...item,\n    intentos_fallidos_nuevo: intentosActuales,\n    bloqueado_hasta_nuevo: bloqueadoHasta\n  }\n};"
      },
