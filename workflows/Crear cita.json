    {
      "parameters": {
        "jsCode": "const s = $('Buscar sesion').first().json;\nconst lockVencido = s.bloqueado_hasta && new Date(s.bloqueado_hasta) <= new Date();\nconst intentos = (lockVencido ? 0 : s.intentos_fallidos) + 1;\n\nreturn [{\n  json: {\n    usuario_id: s.usuario_id,\n    intentos_fallidos_nuevo: intentos,\n    bloqueado_hasta_nuevo: intentos >= 3\n      ? new Date(Date.now() + 15 * 60 * 1000).toISOString()\n      : null\n  }\n}];"
