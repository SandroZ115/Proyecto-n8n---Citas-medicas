    {
      "parameters": {
        "jsCode": "function base32Decode(base32) {\n  const alfabeto = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';\n  let bits = '';\n  for (const char of base32.toUpperCase()) {\n    const val = alfabeto.indexOf(char);\n    if (val === -1) continue;\n    bits += val.toString(2).padStart(5, '0');\n  }\n  const bytes = [];\n  for (let i = 0; i + 8 <= bits.length; i += 8) {\n    bytes.push(parseInt(bits.substr(i, 8), 2));\n  }\n  return Buffer.from(bytes);\n}\n\nfunction generarTOTP(secretBase32) {\n  const crypto = require('crypto');\n  const tiempo = Math.floor(Date.now() / 1000 / 30);\n  const buffer = Buffer.alloc(8);\n  buffer.writeBigInt64BE(BigInt(tiempo));\n  const hmac = crypto.createHmac('sha1', base32Decode(secretBase32)).update(buffer).digest();\n  const offset = hmac[hmac.length - 1] & 0xf;\n  const codigo = ((hmac[offset] & 0x7f) << 24) | ((hmac[offset + 1] & 0xff) << 16) |\n                 ((hmac[offset + 2] & 0xff) << 8) | (hmac[offset + 3] & 0xff);\n  return (codigo % 1000000).toString().padStart(6, '0');\n}\n\nconst s = $('Buscar sesion').first().json;\nconst codigo = String($('Validar cita').first().json.codigo_totp || '');\n\nlet resultado = 'invalido';\nif (s.esta_bloqueado) {\n  resultado = 'bloqueado';\n} else if (codigo === generarTOTP(s.totp_secret)) {\n  resultado = 'valido';\n}\n\nreturn [{ json: { resultado } }];"
      },
