    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH elegido AS (\n  SELECT u.id FROM usuarios u\n  JOIN especialidades e ON e.id = u.especialidad_id\nWHERE u.rol = 'doctor' AND u.activo AND e.activo AND u.especialidad_id = $3::int\n    AND ($5::int = 0 OR u.id = $5::int)\n    AND NOT EXISTS (\n      SELECT 1 FROM solicitudes_citas c\n      WHERE c.doctor_id = u.id AND c.estado <> 'cancelada'\n        AND tsrange(c.horario_asignado, c.horario_asignado + INTERVAL '30 minutes')\n            && tsrange($4::timestamp, $4::timestamp + INTERVAL '30 minutes')\n    )\n  ORDER BY u.id LIMIT 1\n)\nINSERT INTO solicitudes_citas\n  (nombre_paciente, especialidad, especialidad_id, urgencia, estado, doctor_id, horario_asignado, creada_por, correo_paciente)\nSELECT $1, (SELECT nombre FROM especialidades WHERE id = $3::int), $3::int, $2,\n       $7, elegido.id, $4::timestamp, $6::int,\n       CASE WHEN $8::text = 'sin-correo' THEN NULL ELSE $8::text END\nFROM elegido\nRETURNING id, doctor_id, horario_asignado, estado;",
        "options": {
          "queryReplacement": "={{ $('Validar cita').first().json.nombre_paciente }}, {{ $('Validar cita').first().json.urgencia }}, {{ $('Validar cita').first().json.especialidad_id }}, {{ $('Validar cita').first().json.fecha_sql }}, {{ $('Validar cita').first().json.doctor_id }}, {{ $('Validar cita').first().json.creada_por }}, {{ $('Validar cita').first().json.estado_cita }}, {{ $('Validar cita').first().json.correo_paciente }}"
        }
      },
