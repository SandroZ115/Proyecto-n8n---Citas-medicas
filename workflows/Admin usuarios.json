    {
      "parameters": {
        "jsCode": "const body = $('Recibir usuarios').first().json.body || {};\nconst sesion = $('Buscar sesion admin').first().json;\n\nconst accion = String(body.accion || '').trim().toLowerCase();\nconst id = Number(body.usuario_id || 0);\nconst valida = ['listar', 'baja', 'reactivar'].includes(accion)\n  && (accion === 'listar' || (Number.isInteger(id) && id > 0));\n\nreturn [{\n  json: {\n    accion,\n    valida,\n    usuario_id: id,\n    admin_id: Number(sesion.usuario_id)\n  }\n}];"
      },
