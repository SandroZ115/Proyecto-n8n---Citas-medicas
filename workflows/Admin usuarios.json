    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id, u.correo, u.rol, u.activo,\n       e.nombre AS especialidad,\n       (u.bloqueado_hasta IS NOT NULL AND u.bloqueado_hasta > NOW()) AS bloqueado,\n       (SELECT COUNT(*)::int FROM solicitudes_citas c\n         WHERE c.doctor_id = u.id\n           AND c.estado NOT IN ('cancelada', 'completada')\n           AND c.horario_asignado > NOW()) AS citas_abiertas\nFROM usuarios u\nLEFT JOIN especialidades e ON e.id = u.especialidad_id\nORDER BY u.activo DESC, u.rol, u.correo;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
