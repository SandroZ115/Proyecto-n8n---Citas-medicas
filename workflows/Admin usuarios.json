    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH objetivo AS (\n  SELECT id, rol FROM usuarios WHERE id = $1::int AND activo\n),\nverificacion AS (\n  SELECT o.id,\n    CASE\n      WHEN o.id = $2::int THEN 'propio'\n      WHEN o.rol = 'admin'\n        AND (SELECT COUNT(*) FROM usuarios WHERE rol = 'admin' AND activo) <= 1\n        THEN 'ultimo_admin'\n      WHEN o.rol = 'doctor' AND EXISTS (\n        SELECT 1 FROM solicitudes_citas c\n        WHERE c.doctor_id = o.id\n          AND c.estado NOT IN ('cancelada', 'completada')\n          AND c.horario_asignado > NOW()\n      ) THEN 'citas_abiertas'\n      ELSE 'ok'\n    END AS resultado\n  FROM objetivo o\n),\nbaja AS (\n  UPDATE usuarios SET activo = FALSE\n  WHERE id IN (SELECT id FROM verificacion WHERE resultado = 'ok')\n  RETURNING id\n),\ncierre AS (\n  DELETE FROM sesiones WHERE usuario_id IN (SELECT id FROM baja)\n),\nauditoria AS (\n  INSERT INTO bitacora (accion, detalle)\n  SELECT 'usuario_baja', 'Admin ' || $2::int || ' dio de baja al usuario ' || id FROM baja\n)\nSELECT COALESCE((SELECT resultado FROM verificacion), 'no_encontrado') AS resultado,\n       (SELECT COUNT(*)::int FROM solicitudes_citas c\n         WHERE c.doctor_id = $1::int\n           AND c.estado NOT IN ('cancelada', 'completada')\n           AND c.horario_asignado > NOW()) AS citas_abiertas;",
        "options": {
          "queryReplacement": "={{ $('Leer accion').first().json.usuario_id }}, {{ $('Leer accion').first().json.admin_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
