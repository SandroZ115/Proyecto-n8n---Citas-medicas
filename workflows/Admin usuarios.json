    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH reactivado AS (\n  UPDATE usuarios u\n  SET activo = TRUE, intentos_fallidos = 0, bloqueado_hasta = NULL\n  WHERE u.id = $1::int AND NOT u.activo\n    AND (u.rol <> 'doctor' OR EXISTS (\n      SELECT 1 FROM especialidades e WHERE e.id = u.especialidad_id AND e.activo))\n  RETURNING u.id, u.correo\n),\nauditoria AS (\n  INSERT INTO bitacora (accion, detalle)\n  SELECT 'usuario_reactivado', 'Admin ' || $2::int || ' reactivó al usuario ' || id FROM reactivado\n)\nSELECT id, correo FROM reactivado;",
        "options": {}
