    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id, u.correo, e.nombre AS especialidad\nFROM usuarios u\nJOIN especialidades e ON e.id = u.especialidad_id\nWHERE u.rol = 'doctor'\n  AND u.especialidad_id = $1::int\n  AND e.activo\n  AND NOT EXISTS (\n    SELECT 1 FROM solicitudes_citas c\n    WHERE c.doctor_id = u.id\n      AND c.estado <> 'cancelada'\n      AND tsrange(c.horario_asignado, c.horario_asignado + INTERVAL '30 minutes')\n          && tsrange($2::timestamp, $2::timestamp + INTERVAL '30 minutes')\n  )\nORDER BY u.id;",
        "options": {
          "queryReplacement": "={{ $json.especialidad_id }}, {{ $json.fecha_sql }}"
        }
      },
