      "id": "2f9b5d2b-81b1-46e8-9194-09ae1e94094b",
      "name": "Revisar Citas de Manana"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE solicitudes_citas c\nSET estado = 'recordada'\nWHERE c.id IN (\n  SELECT id FROM solicitudes_citas\n  WHERE estado = 'notificada'\n    AND horario_asignado BETWEEN NOW() AND NOW() + INTERVAL '24 hours'\n  ORDER BY horario_asignado\n  LIMIT 10\n  FOR UPDATE SKIP LOCKED\n)\nRETURNING c.id, c.nombre_paciente, c.correo_paciente, c.especialidad, c.horario_asignado;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        32,
        16
      ],
      "id": "a6adb667-8951-4532-8e40-7be5956f166a",
      "name": "Reclamar citas",
      "credentials": {
        "postgres": {
          "id": "ICEUfrnRBAkaWxXN",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $input.item.json;\nconst correo = String(c.correo_paciente || '').trim();\nconst fecha = new Date(c.horario_asignado).toLocaleString('es-GT', {\n  timeZone: 'America/Guatemala',\n  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',\n  hour: '2-digit', minute: '2-digit'\n});\n\nreturn {\n  json: {\n    id: c.id,\n    correo_paciente: correo,\n    tiene_correo: correo.length > 0,\n    asunto: 'Recordatorio de su cita en MediNova',\n    texto: `Estimado/a ${c.nombre_paciente}:\\n\\nLe recordamos su cita de ${c.especialidad} programada para el ${fecha} (hora de Guatemala).\\n\\nSi no puede asistir, comuníquese con la clínica con anticipación.\\n\\nMediNova`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "7c908470-994c-4a87-a8ff-49d5c93ed674",
