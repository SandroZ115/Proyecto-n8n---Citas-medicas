        "query": "UPDATE solicitudes_citas\nSET estado = CASE $2 WHEN 'cancelar' THEN 'cancelada' ELSE 'completada' END\nWHERE id = $1::int\n  AND estado NOT IN ('cancelada', 'completada')\n  AND (\n       ($3 = 'doctor' AND doctor_id = $4::int)\n    OR  $3 = 'admin'\n    OR ($3 = 'secretaria' AND $2 = 'cancelar')\n  )\n  AND ($2 <> 'completar' OR estado IN ('asignada', 'notificada', 'recordada'))\nRETURNING id, estado;",
