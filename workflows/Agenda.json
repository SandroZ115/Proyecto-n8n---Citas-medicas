    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.nombre_paciente, c.urgencia, c.estado,\n       c.horario_asignado, c.horario_fin, c.doctor_id,\n       u.correo AS doctor, e.nombre AS especialidad\nFROM solicitudes_citas c\nLEFT JOIN usuarios u ON u.id = c.doctor_id\nLEFT JOIN especialidades e ON e.id = c.especialidad_id\nWHERE c.doctor_id IS NOT NULL\n  AND c.horario_asignado >= $1::timestamp\n  AND c.horario_asignado <  $2::timestamp\n  AND ($3::int = 0 OR c.doctor_id = $3::int)\n  AND ($4::int = 0 OR c.especialidad_id = $4::int)\nORDER BY c.horario_asignado, c.id;",
        "options": {
          "queryReplacement": "={{ $('Preparar datos').first().json.desde }}, {{ $('Preparar datos').first().json.hasta }}, {{ $('Preparar datos').first().json.doctor_filtro }}, {{ $('Preparar datos').first().json.especialidad_filtro }}"
        }
